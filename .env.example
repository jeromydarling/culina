# ─────────────────────────────────────────────────────────────
# Culina environment variables
# Copy to .env.local (web) and .dev.vars (worker) and fill in.
# The web app runs in DEMO MODE with seeded mock data if the
# Supabase vars below are left blank.
# ─────────────────────────────────────────────────────────────

# Supabase (server / worker)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_FEE_PERCENT=1.5

# Anthropic (Claude API — used by the worker AI proxy only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@culina.app

# App (Vite — must be prefixed with VITE_ to reach the browser)
VITE_APP_URL=https://culina.app
VITE_API_URL=http://localhost:8787
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
