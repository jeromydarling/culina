# ─────────────────────────────────────────────────────────────
# Culina environment variables — 100% Cloudflare (no external accounts)
# Persistence: Cloudflare D1 (SQLite) + R2 (files). Auth: Worker JWT.
#
# The web app runs in DEMO MODE on seeded in-memory data unless VITE_USE_API
# is "true" (and the Worker has a D1 database bound).
# ─────────────────────────────────────────────────────────────

# Web (Vite — must be VITE_-prefixed to reach the browser)
VITE_APP_URL=https://culina.app
VITE_API_URL=                 # blank = same-origin (unified Worker). Dev: http://localhost:8787
VITE_USE_API=false            # set "true" to use the real Cloudflare backend instead of demo data
VITE_STRIPE_PUBLISHABLE_KEY=

# Worker secrets (set with `wrangler secret put <NAME>`)
AUTH_SECRET=                  # HMAC secret for signing JWTs (generate a long random string)
ANTHROPIC_API_KEY=            # optional — Claude text features; image gen uses the AI binding (no key)
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_FEE_PERCENT=1.5
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@culina.app

# Cloudflare bindings are configured in wrangler.jsonc (D1: DB, R2: STORAGE, AI: AI).
