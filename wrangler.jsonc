{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Single Worker that serves the React SPA (static assets) AND the /api/*
  // routes (Claude proxy, Flux images, Stripe). Cloudflare Workers Builds picks
  // this up from the repo root and deploys on every push to main — no dashboard
  // configuration needed. `run_worker_first` lets the Worker handle /api/*;
  // everything else is proxied to the ASSETS binding (with SPA fallback).
  "name": "culina",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  "build": {
    "command": "npm run build"
  },

  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only API requests invoke the Worker; static assets are served directly
    // (cheaper + faster). Requires wrangler v4.
    "run_worker_first": ["/api/*"]
  },

  "ai": {
    "binding": "AI"
  },

  // Built-in logs/observability for the Worker.
  "observability": {
    "enabled": true
  },

  // Scheduled jobs: daily compliance sweep + monthly auto-invoicing.
  "triggers": {
    "crons": ["0 13 * * *", "0 6 1 * *"]
  },

  // Cloudflare D1 (SQLite) — the database (created in this account).
  // Migrations live in /migrations and are applied with:
  //   npx wrangler d1 migrations apply culina --remote
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "culina",
      "database_id": "fb2ded31-3500-4f56-bc8b-a1834d35dc7a",
      "migrations_dir": "migrations"
    }
  ],

  // Cloudflare R2 — file storage for documents, logos, and menu images.
  "r2_buckets": [
    { "binding": "STORAGE", "bucket_name": "culina-files" }
  ],

  // Cloudflare Images — on-the-fly thumbnails for /api/files?w= (lean WebP).
  "images": { "binding": "IMAGES" },

  "vars": {
    "ANTHROPIC_MODEL": "claude-3-5-sonnet-20241022",
    "STRIPE_PLATFORM_FEE_PERCENT": "1.5",
    "ALLOWED_ORIGIN": "*"
  }
}
