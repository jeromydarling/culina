{
  "name": "culina",
  "version": "1.0.0",
  "private": true,
  "description": "Culina — the all-in-one platform for shared commercial kitchens and the food entrepreneurs inside them.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "dev:worker": "npm run dev --workspace apps/worker",
    "build": "npm run build --workspace packages/shared && npm run build --workspace apps/web",
    "build:web": "npm run build --workspace apps/web",
    "build:worker": "npm run build --workspace apps/worker",
    "deploy": "wrangler deploy",
    "preview": "npm run build && wrangler dev",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "wrangler": "^4.20.0"
  },
  "license": "MIT"
}
