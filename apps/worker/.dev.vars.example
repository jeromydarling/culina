# Copy to .dev.vars for `wrangler dev`. Never commit real secrets.
# (D1, R2, and AI are bindings, configured in wrangler.jsonc — not secrets.)
AUTH_SECRET=dev-insecure-secret-change-me
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@culina.app
# Server-side Sentry DSN — captures worker request + cron errors. Already set as
# a CF Worker secret in prod; unset locally → Sentry no-ops.
SENTRY_DSN=
